<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:HalvingFun.Views"
             x:Class="HalvingFun.Pages.CircleHalfPage"
             NavigationPage.HasNavigationBar="False"
             Title="Circle half">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Padding="16,10,16,14" RowSpacing="10">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Text="←"
                        Style="{StaticResource RoundIconButton}"
                        Clicked="OnBackClicked"
                        SemanticProperties.Description="Go back" />
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label x:Name="PromptLabel" Style="{StaticResource Prompt}" />
                    <Label x:Name="ProgressLabel" Style="{StaticResource Hint}" />
                </VerticalStackLayout>
                <Border Grid.Column="2" Style="{StaticResource StarBadge}" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="⭐" FontSize="17" />
                        <Label x:Name="StarsLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="17" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource PlayCard}">
                <Grid x:Name="PlayArea">
                    <Grid x:Name="ItemGrid" RowSpacing="0" ColumnSpacing="0" Padding="0" />
                    <GraphicsView x:Name="Ink"
                                  BackgroundColor="Transparent"
                                  StartInteraction="OnInkStart"
                                  DragInteraction="OnInkDrag"
                                  EndInteraction="OnInkEnd"
                                  CancelInteraction="OnInkEnd" />
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <HorizontalStackLayout x:Name="PenBar" Spacing="6" HorizontalOptions="Center" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="Clear"
                            Style="{StaticResource SecondaryButton}"
                            Clicked="OnClearClicked"
                            SemanticProperties.Description="Clear the rings" />
                    <Button Grid.Column="1"
                            Text="Check"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnCheckClicked"
                            SemanticProperties.Description="Check my answer" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <views:FeedbackOverlay x:Name="Feedback" />
    </Grid>
</ContentPage>
